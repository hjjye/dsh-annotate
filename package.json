{
  "name": "@dsh-external/dsh-annotate",
  "version": "0.1.1",
  "description": "DSH 行内批注插件（Codex 风格）：框选会话文字 → 添加批注 → 主对话框玻璃气泡 + 原文追踪编辑 → 随消息发送。配合 dsh-super-injector 运行时注入，无需构建。",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "README.md", "LICENSE", "install.ps1"],
  "license": "MIT",
  "keywords": ["dsh", "plugin", "annotation", "批注", "codex"],
  "repository": {
    "type": "git",
    "url": "https://github.com/hjjye/dsh-annotate.git"
  },
  "homepage": "https://github.com/hjjye/dsh-annotate",
  "bugs": {
    "url": "https://github.com/hjjye/dsh-annotate/issues"
  },
  "dsh": {
    "client": {
      "inject": ["@deepseek-ai/dsh-client-runtime", "@deepseek-ai/dsh-client-ui-slots"],
      "platform": "web"
    }
  }
}
